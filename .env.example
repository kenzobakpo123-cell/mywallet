# Contoh konfigurasi. Salin ke .env lalu isi nilai yang benar.
# Gunakan user MySQL khusus aplikasi (bukan root) dengan hak minimum.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/keuangan"

# String acak MINIMAL 32 karakter dari CSPRNG, beda untuk tiap environment.
# Contoh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER"

# Arcjet (https://app.arcjet.com) -> Site Key. Kalau kosong, aplikasi memakai
# rate limiter in-memory sebagai fallback. Isi di production.
ARCJET_KEY="ajkey_GANTI_DENGAN_SITE_KEY_ARCJET"

# Resend untuk email verifikasi & reset password (https://resend.com).
# Tanpa key di development, tautan email hanya dicetak di terminal.
RESEND_API_KEY="re_GANTI_DENGAN_API_KEY_RESEND"
EMAIL_FROM="Finwise <onboarding@resend.dev>"

# Wajib HTTPS untuk aplikasi Expo. Tidak boleh memuat username/password.
# EXPO_PUBLIC_API_URL="https://alamat-api-anda.example.com"
