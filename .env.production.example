# Salin ke .env.production lalu isi semua nilai sebelum `docker compose -f docker-compose.prod.yml up -d`.
# MySQL (service `mysql` di compose)
MYSQL_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_YA_KUAT
MYSQL_DATABASE=keuangan
MYSQL_USER=finwise
MYSQL_PASSWORD=GANTI_PASSWORD_FINWISE_YA_KUAT

# Aplikasi
NODE_ENV=production
# Contoh ini KHUSUS Docker Compose (host `mysql` = nama service di compose).
# Untuk Vercel/Railway, salin DATABASE_URL asli dari dashboard provider.
# Jangan pakai nilai placeholder GANTI_PASSWORD... di production.
DATABASE_URL="mysql://finwise:GANTI_PASSWORD_FINWISE_YA_KUAT@mysql:3306/keuangan"
JWT_SECRET=GANTI_STRING_ACAK_MINIMAL_32_KARAKTER
ARCJET_KEY=ajkey_GANTI_DENGAN_SITE_KEY_ARCJET
RESEND_API_KEY=re_GANTI_DENGAN_API_KEY_RESEND
EMAIL_FROM="Finwise <no-reply@domainkamu.com>"
APP_URL="https://alamat-aplikasi-kamu.example.com"
# Daftar email yang boleh mendaftar, dipisah koma. @domain.com juga boleh.
ALLOWED_EMAILS="kenzobakpo123@gmail.com"
