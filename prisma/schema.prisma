generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TxType {
  INCOME
  EXPENSE
}

model User {
  id                   Int           @id @default(autoincrement())
  name                 String
  email                String        @unique
  passwordHash         String
  tokenVersion         Int           @default(0)
  timezone             String        @default("UTC")
  currency             String        @default("IDR")
  emailVerified        DateTime?
  verificationToken    String?       @unique
  verificationExpires  DateTime?
  passwordResetToken    String?       @unique
  passwordResetExpires  DateTime?
  // Rahasia TOTP dan rahasia proses pendaftaran disimpan terenkripsi (AES-GCM).
  twoFactorEnabled      Boolean       @default(false)
  twoFactorSecret       String?       @db.VarChar(512)
  twoFactorPendingSecret String?      @db.VarChar(512)
  createdAt             DateTime      @default(now())
  transactions          Transaction[]
  wallets               Wallet[]
  categories            Category[]
  budgets               Budget[]
  sessions              Session[]
  twoFactorRecoveries   TwoFactorRecovery[]
}

/** Kode pemulihan 2FA disimpan sebagai hash SHA-256 dan hanya bisa dipakai sekali. */
model TwoFactorRecovery {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String    @db.VarChar(64)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
}

model Session {
  id         Int       @id @default(autoincrement())
  userId     Int
  // Refresh token disimpan sebagai hash SHA-256, bukan token mentah.
  tokenHash         String    @unique @db.VarChar(64)
  // Hash token sebelumnya dipakai untuk mendeteksi replay/Reuse setelah rotasi.
  previousTokenHash String?   @unique @db.VarChar(64)
  label      String    @db.VarChar(191)
  ip         String?   @db.VarChar(191)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      TxType
  amount    Int
  category  String
  note      String?
  date      DateTime
  // Tanggal kalender menurut zona waktu pengguna; tidak berubah saat zona waktu diganti.
  dateKey   String    @db.VarChar(10)
  walletId  Int?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet    Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([userId, dateKey, date])
  @@index([userId, date])
}

model Wallet {
  id             Int           @id @default(autoincrement())
  userId         Int
  name           String
  initialBalance Int           @default(0)
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([userId, name])
}

model Category {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  type      TxType
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budgets   Budget[]

  @@unique([userId, name, type])
}

model Budget {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  month      String
  limit      Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

/** Rate limit bersama lintas instance serverless untuk endpoint kritis. */
model RateLimit {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(191)
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String?
  entityId  Int?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}
